<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/blur_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/colombiaflagicon"
            android:layout_marginBottom="16dp"/>

        <!-- Nombre -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textColor="@color/principal_green"
            android:textSize="20dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_lettering"
            android:hint="Product Name"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Type"
            android:textColor="@color/principal_green"
            android:layout_marginBottom="10dp"
            android:textSize="20dp"/>

        <TextView
            android:id="@+id/etType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_lettering"
            android:hint="Product Type"
            android:textSize="18dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select New Product Type"
            android:textColor="@color/principal_green"
            android:textSize="18dp"/>

        <Spinner
            android:id="@+id/spinner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Descripción -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detail"
            android:textColor="@color/principal_green"
            android:textSize="20dp"/>

        <EditText
            android:id="@+id/etDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_lettering"
            android:hint="Detail"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginBottom="12dp" />

        <!-- Precio -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price"
            android:textColor="@color/principal_green"
            android:textSize="20dp"/>

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_lettering"
            android:hint="Price"
            android:inputType="numberDecimal"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score"
            android:textColor="@color/principal_green"
            android:textSize="20dp"/>

        <EditText
            android:id="@+id/etScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_lettering"
            android:hint="Score"
            android:inputType="numberDecimal"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Image Url"
            android:textColor="@color/principal_green"
            android:textSize="20dp"/>

        <EditText
            android:id="@+id/etImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_lettering"
            android:hint="Image URL"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- Botón guardar -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:backgroundTint="@color/principal_green"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- Botón eliminar -->
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Product"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>